# Text: stable LF for cross-platform diffs / Pages HTML
* text=auto eol=lf

*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.lua  text eol=lf
*.toc  text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf

# Built / binary assets — no EOL conversion
*.zip  binary
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.blp  binary
